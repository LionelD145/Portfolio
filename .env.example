# Copiez en .env (ou définissez ces variables chez votre hébergeur).
PORT=5174
HOST=127.0.0.1
# Derrière un proxy HTTPS (Render, Railway, nginx, Caddy…) : TRUST_PROXY=1
TRUST_PROXY=0
# Premier mot de passe admin (sinon : npm run password). Min. 10 caractères.
# ADMIN_PASSWORD=
# Clé de signature des sessions (32+ caractères). Générée automatiquement si absente.
# SESSION_SECRET=
# Dossier des données (content.json, sauvegardes, mot de passe haché) — à monter sur un volume persistant.
# DATA_DIR=./data
# Dossier des images/CV envoyés depuis l'admin (défaut : assets/). À mettre sur un volume persistant si le disque est éphémère.
# UPLOADS_DIR=./data/uploads
# Jeton GitHub en lecture seule pour la synchronisation des dépôts.
# GITHUB_TOKEN=
